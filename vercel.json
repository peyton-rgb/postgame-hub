{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "functions": {
    "src/app/api/pitches/generate/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/heroes/render/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/intake/tag/route.ts": {
      "maxDuration": 300
    },
    "src/app/api/tag/route.ts": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/recap-intake",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/admin-sync/campaigns",
      "schedule": "45 10 * * *"
    },
    {
      "path": "/api/sync/asana-managers",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/sync/admin-accounts",
      "schedule": "15 11 * * *"
    },
    {
      "path": "/api/sync/drive-folders",
      "schedule": "30 11 * * *"
    },
    {
      "path": "/api/cron/recap-readiness",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/health-check",
      "schedule": "0 12 * * 1"
    }
  ]
}
