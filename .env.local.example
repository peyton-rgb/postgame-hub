# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional: custom domain for recap URLs
# NEXT_PUBLIC_SITE_URL=https://postgame.co

# Athlete app — Google Drive root folder ("Campaigns") for athlete deal folders.
# When unset (or GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON missing), athlete Drive
# folders are skipped (no-op) and uploads still work. See src/lib/athlete-drive.ts.
# ATHLETE_DRIVE_ROOT_FOLDER_ID=your-drive-folder-id

# Auto editor — content scoring (Anthropic vision). ANTHROPIC_API_KEY enables
# real scoring; without it the curator returns clearly-labelled stub results.
# AUTO_EDITOR_MODEL overrides the model (default claude-opus-4-8; e.g. set to
# claude-sonnet-4-6 to cut cost on large photo batches).
# ANTHROPIC_API_KEY=sk-ant-...
# AUTO_EDITOR_MODEL=claude-opus-4-8

# Manager layer — Slack delivery for manager notifications. UNSET = no-op
# (in-app notifications still fire). Create an Incoming Webhook in Slack and put
# its URL here. SLACK_DRY_RUN=1 logs the payload instead of sending (testing).
# SLACK_EVENTS optionally limits which event types post (comma-separated).
# NEVER commit a real webhook. See docs/manager-layer/SLACK-SETUP.md.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
# SLACK_DRY_RUN=
# SLACK_EVENTS=
# NEXT_PUBLIC_SITE_URL=https://postgame-hub.vercel.app   # used for absolute Slack links

# Manager layer — deadline-check cron. Set a secret, then point a Vercel cron at
# GET /api/staff/manager/check-deadlines with header x-cron-key (or ?key=).
# CRON_SECRET=

# Athlete app — PayPal payouts (STUBBED; not yet wired to live money).
# Add real credentials before enabling payout execution.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_MODE=sandbox

# Videographer W-9 uploads (/w9). Parent of the per-year folders in Drive —
# "Internal All / W9". The route calls ensureFolder() to find-or-create
# "<tax year> W-9s" underneath it, so a new year needs no code change.
# Requires GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN.
# NOTE: adding this on Vercel does NOT redeploy on its own — redeploy after
# setting it, or POST /api/w9 500s on first use.
# W9_DRIVE_PARENT_FOLDER_ID=your-drive-folder-id

# Campaign folder provisioning (/api/sync/drive-folders and
# scripts/provision-campaign-folders.ts). The folder holding ONE SUBFOLDER PER
# BRAND — the level above the year shelves. A brand with no stored
# drive_parent_folder_id has its root looked up by name under here, and the id
# is saved on the brand so the search happens once per brand, ever.
# Nothing ever CREATES a brand folder here; sales does that by hand.
# Requires GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN.
# NOTE: adding this on Vercel does NOT redeploy on its own — redeploy after
# setting it, or every brand without a stored root skips as no_brand_root.
# DRIVE_CLIENT_ROOT_FOLDER_ID=your-drive-folder-id

# Postgame admin API (read-only sync: admin → Hub, never back). Powers
# POST /api/admin-sync/campaigns. The admin runs on its OWN Supabase project,
# separate from the Hub's — this key is scoped to that project's Edge Function.
# SERVER-SIDE ONLY: never add a NEXT_PUBLIC_ prefix, or the key ships to the
# browser and is readable by anyone who opens devtools.
# NOTE: adding these on Vercel does NOT redeploy on its own — redeploy after
# setting them, or the route 500s with a "not configured" error on first use.
# POSTGAME_ADMIN_API_URL=https://<admin-project-ref>.functions.supabase.co/api-v1
# POSTGAME_ADMIN_API_KEY=pg_live_...
